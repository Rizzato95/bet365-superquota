# Copy to .env. The public key is safe to expose ONLY with the supplied RLS policies.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# GA4 measurement ID. Empty disables tracking; development is always excluded.
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Explicit read-only snapshot mode, never a fallback after a database error.
NUXT_DEMO_MODE=false
# Used exclusively by scripts/import.ts, never by the app or public runtime config.
SUPABASE_SECRET_KEY=
